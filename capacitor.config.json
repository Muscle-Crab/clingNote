{
  "appId": "app.clingnote.ios",
  "appName": "CleanNote",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "scheme": "ClingNot"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        },
        "swiftToolsVersion": "6.1"
      }
    }
  }
}
