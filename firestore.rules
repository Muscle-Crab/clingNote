rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TIGHT ruleset + paywall hardening: isPro/plan/proExpiresAt/stripe* are written only by Netlify functions (admin SDK).
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Fields only the server (Stripe webhook / AI function, admin SDK) may change
    function billingKeys() {
      return ['hasPaid', 'premium', 'credits', 'subscription', 'subscriptionId', 'subscriptionStatus', 'stripeCustomerId', 'admin', 'role',
              'proExpiresAt', 'stripeSubscriptionId', 'stripeStatus', 'stripePriceId', 'stripeSessionId', 'stripe', 'proUpdatedAt'];
    }
    // isPro / plan: clients may only ever write the free defaults, and never on a doc that is currently Pro.
    function freeDefaultsOnly() {
      return request.resource.data.get('isPro', false) == false
        && request.resource.data.get('plan', 'free') == 'free';
    }
    function proFieldsOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro', 'plan'])
        || (resource.data.get('isPro', false) != true && freeDefaultsOnly());
    }

    // Users collection - private to the owner. Other users' names/avatars come from /publicProfiles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Signup may set the starter 15 credits, nothing else billing-related
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAny(billingKeys().removeAll(['credits'])) == false
        && freeDefaultsOnly()
        && (!('credits' in request.resource.data) || request.resource.data.credits == 15);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingKeys())
        && proFieldsOk();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Public profile (name, avatar, pickup attendance) readable by signed-in users
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'avatarURL', 'attending', 'updatedAt']);
      // Pickup board: any signed-in user may toggle attendance only
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attending']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'reactions', 'readComments']));
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Rooms collection - owner (user_id) edits/approves/deletes; others may only append a join request
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid
        && request.resource.data.approvedUsers == [request.auth.uid];
      allow update: if isAuthenticated() && (
        (resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests'])
            && request.resource.data.requests.size() == resource.data.requests.size() + 1
            && !(request.auth.uid in resource.data.approvedUsers)));
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Tasks collection - unused by the app
    match /tasks/{taskId} {
      allow read, write: if false;
    }

    // Weekly Routines - routineId format: {userId}_{dayName}
    match /weeklyRoutines/{routineId} {
      allow read, write: if isAuthenticated() && request.auth.uid == routineId.split('_')[0];
    }

    // Captains collection
    match /captains/{captainId} {
      allow read, write: if isAuthenticated();
    }

    // Game collection (incl. game/turnState)
    match /game/{gameId} {
      allow read, write: if isAuthenticated();
    }

    // Streaks - doc id is the uid
    match /streaks/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Won't Do Tasks - users can only access their own
    match /wontDoTasks/{userId_day} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == userId_day.split("_")[0];
    }
    
    // Daily Reports - users can only access their own
    match /dailyReports/{reportId} {
      allow read, write: if isAuthenticated() &&
        request.auth.uid == reportId.split('_')[0];
    }
    
    // NoFap subcollection
    match /users/{userId}/nofap/{docId} {
      allow read, write: if isOwner(userId);
    }
    
    // Meals collection
    match /meals/{mealId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // User Settings
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // ===== NEW GAMIFICATION COLLECTIONS =====
    
    // User Ranks - users can read/write their own rank data
    match /userRanks/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Badges/Achievements - users can read/write their own badges
    match /badges/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // ===== ADDED (streak-fix release): paths not covered by existing rules =====

    // Monthly ranking: public leaderboard summary. Authed users read opted-in entries (+ always their own); owner writes.
    match /monthlyStats/{month}/users/{uid} {
      allow read: if isAuthenticated() && (resource.data.optIn == true || request.auth.uid == uid);
      allow write: if isOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // Monthly ranking: per-user private detail (task keys, point adjustments)
    match /monthlyStats/{month}/private/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Discipline Mode state (deadline settlement, log, boss, breaks, XP, theme, freezes)
    match /discipline/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Calendar feed tokens: owner creates/deletes own token; only the server (admin SDK) reads them
    match /icsTokens/{token} {
      allow create: if isAuthenticated() && token.matches('^[a-f0-9]{48}$')
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow read, update: if false;
    }

    // ===== Manager & Pal (netlify/functions/manager-pal.js writes everything except pal DMs and the read flag) =====
    // Manager link state: owner reads; only the function writes. Token itself is never stored (managerLinks is keyed by sha256(token)).
    match /managers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // Signed-in manager <-> user connection. Created/removed only by the manager-pal function (admin SDK).
    match /managerConnections/{connId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || request.auth.uid == resource.data.managerUid);
      allow write: if false;
    }
    match /managerLinks/{hash} { allow read, write: if false; }
    // Block + Report (App Store 1.2): written only by the manager-pal function.
    match /blocks/{blockId} { allow read: if isAuthenticated() && request.auth.uid == resource.data.blockerUid; allow write: if false; }
    match /reports/{reportId} { allow read, write: if false; }
    match /palInvites/{code} { allow read, write: if false; }
    // Manager nudges + DMs (both directions). Owner reads and may only flip `read`.
    match /users/{uid}/managerChat/{msgId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow create, delete: if false;
    }
    // Pal pair: created by the function on accept; either member reads or removes it.
    match /pals/{pairId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create, update: if false;
      match /messages/{msgId} {
        function palMember() { return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/pals/$(pairId)).data.members; }
        allow read: if palMember();
        allow create: if palMember()
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
