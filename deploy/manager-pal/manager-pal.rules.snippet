    // ===== Manager & Pal (netlify/functions/manager-pal.js writes everything except pal DMs and the read flag) =====
    // Manager link state: owner reads; only the function writes. Token itself is never stored (managerLinks is keyed by sha256(token)).
    match /managers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // Signed-in manager <-> user connection. Created/removed only by the manager-pal function (admin SDK).
    match /managerConnections/{connId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || request.auth.uid == resource.data.managerUid);
      allow write: if false;
    }
    match /managerLinks/{hash} { allow read, write: if false; }
    // Block + Report (App Store 1.2): written only by the manager-pal function.
    match /blocks/{blockId} { allow read: if isAuthenticated() && request.auth.uid == resource.data.blockerUid; allow write: if false; }
    match /reports/{reportId} { allow read, write: if false; }
    match /palInvites/{code} { allow read, write: if false; }
    // Manager nudges + DMs (both directions). Owner reads and may only flip `read`.
    match /users/{uid}/managerChat/{msgId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow create, delete: if false;
    }
    // Pal pair: created by the function on accept; either member reads or removes it.
    match /pals/{pairId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create, update: if false;
      match /messages/{msgId} {
        function palMember() { return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/pals/$(pairId)).data.members; }
        allow read: if palMember();
        allow create: if palMember()
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

